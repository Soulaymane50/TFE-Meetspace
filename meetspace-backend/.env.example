# Local profile. Use prod for a real deployment.
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:mysql://localhost:3306/meetspace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Brussels
DB_USERNAME=root
DB_PASSWORD=

# JPA / Flyway
DDL_AUTO=validate
SHOW_SQL=false
# Local demonstration only. The prod profile never loads this seed.
APP_DEMO_SEED_ENABLED=true

# Server
SERVER_PORT=8080

# JWT - required, minimum 32 characters
# Example generation: openssl rand -hex 32
JWT_SECRET=votre-cle-secrete-minimum-32-caracteres-ici
JWT_EXPIRATION=3600000

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Email / password recovery
# Enable only after configuring a real SMTP account. Never commit credentials.
APP_FRONTEND_URL=http://localhost:5174
APP_MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_ADMIN_EMAIL=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# Local/dev only: log recovery links when SMTP is disabled.
APP_PASSWORD_RESET_LOG_LINK=false
APP_ACCOUNT_DELETION_LOG_LINK=false

# Local/test only. PaymentVerifier also refuses it outside dev/local/test profiles.
APP_TESTING_ALLOWFAKEPAYMENTS=true
