# Profile
SPRING_PROFILES_ACTIVE=prod

# Database
DB_URL=jdbc:mysql://localhost:3306/meetspace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Brussels
DB_USERNAME=root
DB_PASSWORD=

# JPA
DDL_AUTO=validate
SHOW_SQL=false

# Server
SERVER_PORT=8080

# JWT - required, minimum 32 characters
# Example generation: openssl rand -hex 32
JWT_SECRET=votre-cle-secrete-minimum-32-caracteres-ici
JWT_EXPIRATION=3600000

# CORS - comma-separated allowed origins
CORS_ALLOWED_ORIGINS=https://votre-domaine.example

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# Email / password recovery
# Use a real SMTP account locally or in production. Do not commit real passwords.
APP_FRONTEND_URL=http://localhost:5174
APP_MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# Local/dev only: log the reset link in backend logs when SMTP is disabled.
# Keep false in production.
APP_PASSWORD_RESET_LOG_LINK=false

# Local/test only. Production profile always forces this to false.
APP_TESTING_ALLOWFAKEPAYMENTS=false
