# Database
DB_URL=jdbc:mysql://localhost:3306/meetspace?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Brussels
DB_USERNAME=root
DB_PASSWORD=

# JPA
DDL_AUTO=validate
SHOW_SQL=false

# Server
SERVER_PORT=8080

# JWT - OBLIGATOIRE: Minimum 32 caractères
# Générer avec: openssl rand -hex 32
JWT_SECRET=votre-cle-secrete-minimum-32-caracteres-ici
JWT_EXPIRATION=3600000

# CORS - Origines autorisées (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4174,http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_PUBLIC_KEY=pk_live_xxxx

# Testing - Mettre à false en production !
APP_TESTING_ALLOWFAKEPAYMENTS=false
